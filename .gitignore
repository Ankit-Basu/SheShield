# ═══ SheShield .gitignore ═══

# Dependencies
node_modules/
vendor/
composer.phar
package-lock.json
composer.lock

# Environment & Secrets
.env
*.env
app/config/email_config.php
app/config/config.php

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# Uploads (user data)
uploads/

# Build artifacts
dist/
build/

# Cache
.cache/
# Terraform
.terraform/
*.tfstate
*.tfstate.backup
terraform.tfvars
*.terraform.lock.hcl

# AWS Secrets (NEVER commit these)
aws-credentials.txt
*.pem

# Python cache
__pycache__/
*.pyc
