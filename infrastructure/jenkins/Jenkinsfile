// SheShield - Jenkinsfile
// CI/CD Pipeline: Build → Scan → Docker → Deploy (Windows-compatible)

pipeline {
    agent any

    environment {
        DOCKER_IMAGE    = 'sheshield'
        DOCKER_TAG      = "${BUILD_NUMBER}"
        SONAR_HOST_URL  = 'http://host.docker.internal:9000'
        SONAR_TOKEN     = 'squ_1f2367dcecb90facc57f6759efe936e8a76fe8f6'
        NEXUS_URL       = '127.0.0.1:8082'
        KUBE_NAMESPACE  = 'sheshield'
    }

    stages {

        // ─── Stage 1: Checkout ────────────────────────
        stage('Checkout') {
            steps {
                echo 'Pulling source code...'
                checkout scm
            }
        }

        // ─── Stage 2: Build Docker Image ──────────────
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                bat "docker build -t %DOCKER_IMAGE%:%DOCKER_TAG% -f infrastructure/docker/Dockerfile ."
                bat "docker tag %DOCKER_IMAGE%:%DOCKER_TAG% %DOCKER_IMAGE%:latest"
            }
        }

        // ─── Stage 3: Security Scan (Trivy via Docker) ─
        stage('Security Scan') {
            steps {
                echo 'Running Trivy vulnerability scan on Docker image...'
                bat "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --severity HIGH,CRITICAL --exit-code 0 --no-progress %DOCKER_IMAGE%:%DOCKER_TAG% || echo Trivy scan completed"
            }
        }

        // ─── Stage 4: Code Quality (SonarQube) ────────
        stage('SonarQube Analysis') {
            steps {
                echo 'Running SonarQube code quality scan...'
                bat 'docker run --rm -v "%WORKSPACE%:/usr/src" sonarsource/sonar-scanner-cli -Dsonar.projectKey=sheshield -Dsonar.sources=. -Dsonar.host.url=%SONAR_HOST_URL% -Dsonar.token=%SONAR_TOKEN% || echo SonarQube scan completed with warnings'
            }
        }

        // ─── Stage 5: Push to Nexus Registry ──────────
        stage('Push to Nexus') {
            steps {
                echo 'Tagging and pushing image to Nexus registry...'
                bat "docker tag %DOCKER_IMAGE%:%DOCKER_TAG% %NEXUS_URL%/%DOCKER_IMAGE%:%DOCKER_TAG%"
                bat "docker tag %DOCKER_IMAGE%:%DOCKER_TAG% %NEXUS_URL%/%DOCKER_IMAGE%:latest"
                bat "docker login %NEXUS_URL% -u admin -p admin || echo Warning: Nexus Auth Failed"
                bat "docker push %NEXUS_URL%/%DOCKER_IMAGE%:%DOCKER_TAG% || echo Warning: Push failed"
                bat "docker push %NEXUS_URL%/%DOCKER_IMAGE%:latest || echo Warning: Push latest failed"
            }
        }

        // ─── Stage 6: Deploy to Kubernetes ────────────
        stage('Deploy to Kubernetes') {
            steps {
                echo 'Deploying to Kubernetes cluster...'
                bat "kubectl --kubeconfig=C:\\Users\\ankit\\.kube\\config apply --validate=false -f infrastructure/kubernetes/deployment.yaml"
                bat "kubectl --kubeconfig=C:\\Users\\ankit\\.kube\\config get pods -n %KUBE_NAMESPACE%"
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
            echo "App deployed: Build #${BUILD_NUMBER}"
        }
        failure {
            echo 'Pipeline failed! Check logs above.'
        }
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
    }
}
