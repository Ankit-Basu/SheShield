// SheShield - Jenkinsfile
// CI/CD Pipeline: Build → Scan → Docker → Deploy (Windows-compatible)

pipeline {
    agent any

    environment {
        DOCKER_IMAGE    = 'sheshield'
        DOCKER_TAG      = "${BUILD_NUMBER}"
        SONAR_HOST_URL  = 'http://localhost:9000'
        NEXUS_URL       = 'localhost:8082'
        KUBE_NAMESPACE  = 'sheshield'
    }

    stages {

        // ─── Stage 1: Checkout ────────────────────────
        stage('Checkout') {
            steps {
                echo 'Pulling source code...'
                checkout scm
            }
        }

        // ─── Stage 2: Build Docker Image ──────────────
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                bat "docker build -t %DOCKER_IMAGE%:%DOCKER_TAG% -f infrastructure/docker/Dockerfile ."
                bat "docker tag %DOCKER_IMAGE%:%DOCKER_TAG% %DOCKER_IMAGE%:latest"
            }
        }

        // ─── Stage 3: Security Scan (Trivy) ───────────
        stage('Security Scan') {
            steps {
                echo 'Running Trivy vulnerability scan on Docker image...'
                bat '''
@echo off
where trivy >nul 2>nul
if errorlevel 1 (
    echo Trivy is not installed on this Jenkins agent. Skipping non-blocking scan.
    exit /b 0
)

trivy image --severity HIGH,CRITICAL --exit-code 0 %DOCKER_IMAGE%:%DOCKER_TAG%
if errorlevel 1 (
    echo Trivy scan completed with a non-blocking error.
    exit /b 0
)
'''
            }
        }

        // ─── Stage 4: Push to Nexus Registry ──────────
        stage('Push to Nexus') {
            steps {
                echo 'Tagging image for Nexus registry...'
                bat "docker tag %DOCKER_IMAGE%:%DOCKER_TAG% %NEXUS_URL%/%DOCKER_IMAGE%:%DOCKER_TAG%"
                echo 'Push to Nexus would happen here (requires auth credentials)'
            }
        }

        // ─── Stage 5: Deploy to Kubernetes ────────────
        stage('Deploy to Kubernetes') {
            steps {
                echo 'Deploying to Kubernetes cluster...'
                bat "kubectl --kubeconfig=%USERPROFILE%\\.kube\\config apply --validate=false -f infrastructure/kubernetes/deployment.yaml"
                bat "kubectl --kubeconfig=%USERPROFILE%\\.kube\\config get pods -n %KUBE_NAMESPACE%"
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
            echo "App deployed: Build #${BUILD_NUMBER}"
        }
        failure {
            echo 'Pipeline failed! Check logs above.'
        }
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
    }
}
