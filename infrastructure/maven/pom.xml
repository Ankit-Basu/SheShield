<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  SheShield - Maven POM (Build Automation)
  Used for build lifecycle management, Docker image building, 
  and integration with Jenkins/Nexus pipeline
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sheshield</groupId>
    <artifactId>sheshield-app</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>SheShield - Women Safety Application</name>
    <description>A comprehensive women safety platform with emergency SOS, incident reporting, and community features</description>

    <properties>
        <docker.image.name>sheshield</docker.image.name>
        <docker.image.tag>${project.version}</docker.image.tag>
    </properties>

    <build>
        <plugins>
            <!-- Composer Install (PHP Dependencies) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Install Composer Dependencies -->
                    <execution>
                        <id>composer-install</id>
                        <phase>compile</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>composer</executable>
                            <arguments>
                                <argument>install</argument>
                                <argument>--no-dev</argument>
                                <argument>--optimize-autoloader</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Build Tailwind CSS -->
                    <execution>
                        <id>npm-build</id>
                        <phase>compile</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>npm</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Docker Build -->
                    <execution>
                        <id>docker-build</id>
                        <phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>build</argument>
                                <argument>-t</argument>
                                <argument>${docker.image.name}:${docker.image.tag}</argument>
                                <argument>.</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Docker Push to Nexus -->
                    <execution>
                        <id>docker-push</id>
                        <phase>deploy</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>push</argument>
                                <argument>${docker.image.name}:${docker.image.tag}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
