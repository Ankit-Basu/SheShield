{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/vercel-build.js",
  "outputDirectory": "vercel-dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)mobile' ':(exclude).github'",
  "redirects": [
    {
      "source": "/",
      "destination": "/pro/landing.html",
      "permanent": false
    },
    {
      "source": "/index.php",
      "destination": "/pro/landing.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:dir(api|views|admin|uploads)/:path*",
      "destination": "https://sheshield-y9jp.onrender.com/:dir/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:dir(api|views|admin|uploads)/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/public/(fonts|lib|images)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
